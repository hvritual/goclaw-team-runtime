# Copy to ~/.config/goclaw/runner.env and chmod 0600.
# The personal token is sent only to the central Gateway over TLS.
GOCLAW_USER_TOKEN=REPLACE_WITH_PERSONAL_TEAM_TOKEN
GOCLAW_GATEWAY_TOKEN=REPLACE_WITH_SHARED_GATEWAY_BOUNDARY_TOKEN
GOCLAW_GATEWAY_HTTP_URL=https://goclaw.example.com
GOCLAW_RUNNER_ID=alice-laptop
GOCLAW_RUNNER_KEY_FILE=/home/alice/.config/goclaw/alice-laptop.key
GOCLAW_RUNNER_WORK_ROOT=/home/alice/.local/share/goclaw/worktrees
GOCLAW_PROJECT_ID=project-alpha
GOCLAW_REPOSITORY_ID=iot-platform
GOCLAW_REPOSITORY_PATH=/home/alice/src/iot-platform
# Absolute directory created/used by this same account's `codex login`.
# GoClaw gives each run a separate HOME/XDG and uses only this OAuth source.
CODEX_HOME=/home/alice/.codex
# Resolve this once with `command -v codex`; the runner records and executes an
# absolute binary instead of trusting a task-controlled PATH.
GOCLAW_CODEX_COMMAND=/usr/local/bin/codex
# Linux production baseline. Install this reviewed wrapper from
# scripts/verify-sandbox-bwrap.sh as root:root 0755.
GOCLAW_VERIFICATION_SANDBOX=/usr/local/libexec/goclaw/verify-sandbox-bwrap.sh
