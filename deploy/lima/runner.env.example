# Store as ~/.config/goclaw/runner.env with mode 0600 inside the Lima guest.
# Clone the repository inside the guest disk. Do not add a host `mounts` entry.
LIMA_INSTANCE=goclaw-pilot
GOCLAW_USER_TOKEN=REPLACE_WITH_PERSONAL_TEAM_TOKEN
GOCLAW_GATEWAY_TOKEN=REPLACE_WITH_SHARED_GATEWAY_BOUNDARY_TOKEN
GOCLAW_GATEWAY_HTTP_URL=https://goclaw.example.com
GOCLAW_RUNNER_ID=alice-lima
GOCLAW_RUNNER_KEY_FILE=/var/lib/goclaw-runner/alice-lima.key
GOCLAW_RUNNER_WORK_ROOT=/var/lib/goclaw-runner/worktrees
GOCLAW_PROJECT_ID=project-alpha
GOCLAW_REPOSITORY_ID=iot-platform
GOCLAW_REPOSITORY_PATH=/var/lib/goclaw-runner/src/iot-platform
GOCLAW_CODEX_COMMAND=/usr/local/bin/codex
CODEX_HOME=/var/lib/goclaw-runner/codex
GOCLAW_VERIFICATION_SANDBOX=/usr/local/libexec/goclaw/verify-sandbox-bwrap.sh
