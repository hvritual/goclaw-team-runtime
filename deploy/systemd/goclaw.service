[Unit]
Description=GoClaw Better-Harness Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=REPLACE_USER
WorkingDirectory=/opt/goclaw
Environment=HOME=/home/REPLACE_USER
Environment=PATH=/home/REPLACE_USER/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/goclaw/goclaw start
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/REPLACE_USER/.goclaw /srv/goclaw-workspace /srv/obsidian-vault /srv/goclaw-runtime /srv/repos /srv/goclaw-worktrees

[Install]
WantedBy=multi-user.target
